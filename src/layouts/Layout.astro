---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activePage: 'top' | 'service' | 'about' | 'flow' | 'news' | 'contact';
}

const { title, description = '', activePage } = Astro.props;
---

<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="robots" content="all" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />

  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-RCX9D7BV9E"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-RCX9D7BV9E');
  </script>
</head>
<body>

<aside class="sidebar">
  <div class="sidebar-logo-wrap" style="display:flex;flex-direction:column;align-items:center;gap:0">
    <a href="/" class="logo-link">
      <img class="logo-img" src="/images/logo.webp" alt="SHUNKOH" />
      <div class="logo-text">
        <p class="logo-name">SHUNKOH</p>
        <p class="logo-sub">株式会社シュンコー</p>
      </div>
    </a>
    <ul class="sidebar-nav">
      <li><a href="/" class={activePage === 'top' ? 'active' : ''}>トップ</a></li>
      <li><a href="/service" class={activePage === 'service' ? 'active' : ''}>サービス・事例</a></li>
      <li><a href="/about" class={activePage === 'about' ? 'active' : ''}>MVV・会社概要</a></li>
      <li><a href="/flow" class={activePage === 'flow' ? 'active' : ''}>ご相談の流れ</a></li>
      <li><a href="/news" class={activePage === 'news' ? 'active' : ''}>お知らせ</a></li>
    </ul>
  </div>
  <div class="sidebar-bottom">
    <a class="sidebar-contact" href="/contact">
      <span class="material-icons">mail_outline</span>
      <p class="contact-label">お問い合わせはこちら</p>
    </a>
    <button aria-label="メニュー" type="button" class="menu-btn" id="menuBtn">
      <span class="menu-bar"></span>
      <span class="menu-bar"></span>
    </button>
  </div>
</aside>

<div class="modals" id="mobileNav">
  <div class="design-canvas__modal" tabindex="0">
    <div class="studio-canvas" role="dialog">
      <div class="modal-inner">
        <div class="modal-header">
          <button type="button" class="modal-close" id="modalClose" aria-label="閉じる">
            <span class="menu-bar"></span>
            <span class="menu-bar"></span>
          </button>
        </div>
        <div class="modal-body">
          <ul class="modal-nav">
            <li><a href="/" class={activePage === 'top' ? 'active' : ''}>トップ</a></li>
            <li><a href="/service" class={activePage === 'service' ? 'active' : ''}>サービス・事例</a></li>
            <li><a href="/about" class={activePage === 'about' ? 'active' : ''}>MVV・会社概要</a></li>
            <li><a href="/flow" class={activePage === 'flow' ? 'active' : ''}>ご相談の流れ</a></li>
            <li><a href="/news" class={activePage === 'news' ? 'active' : ''}>お知らせ</a></li>
          </ul>
          <a href="/contact" class="modal-contact">
            <span class="material-icons">mail_outline</span>
            <span>お問い合わせはこちら</span>
          </a>
        </div>
      </div>
    </div>
    <button aria-label="閉じる" class="design-canvas__modal__base" id="modalBackdrop"></button>
  </div>
</div>

<main class="main">
  <slot />

  <footer>
    <div class="footer-inner">
      <ul class="footer-nav">
        <li><a href="/">トップ</a></li>
        <li><a href="/service">サービス</a></li>
        <li><a href="/about">MVV・会社概要</a></li>
        <li><a href="/flow">ご相談の流れ</a></li>
        <li><a href="/news">お知らせ</a></li>
        <li><a href="/contact">お問い合わせ</a></li>
      </ul>
      <p class="footer-copy">©2025. SHUNKOH</p>
    </div>
  </footer>
</main>

<button id="backToTop" aria-label="トップに戻る" title="トップに戻る">
  <span class="material-icons">keyboard_arrow_up</span>
</button>

<style>
#backToTop {
  position: fixed; bottom: 32px; right: 32px; z-index: 500;
  width: 48px; height: 48px; border-radius: 50%;
  background: #15263e; border: 1px solid rgba(255,255,255,0.2);
  color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none;
  transition: opacity 0.3s, background 0.2s, scale 0.2s;
}
#backToTop.visible { opacity: 1; pointer-events: auto; }
#backToTop:hover { background: var(--blue2); scale: 1.08; }
#backToTop .material-icons { font-size: 28px; }
@media (max-width: 540px) {
  #backToTop { bottom: 20px; right: 16px; width: 42px; height: 42px; }
  #backToTop .material-icons { font-size: 24px; }
}

.sidebar-bottom { display: flex; flex-direction: column; align-items: center; width: 100%; gap: 12px; }

.menu-btn { display: none; }

.modals { display: none; }

@media (max-width: 960px) {
  .sidebar-bottom { flex-direction: row; align-items: center; gap: 16px; width: auto; margin-left: auto; }

  /* Logo horizontal layout */
  .sidebar-logo-wrap { flex: 0 0 auto; width: auto; }
  .logo-link { flex-direction: row; align-items: center; gap: 12px; width: auto; flex: 0 0 auto; }
  .logo-text { display: flex; flex-direction: column; align-items: flex-start; }
  .logo-img { width: 56px; max-width: none; margin-bottom: 0; }
  .logo-name { font-size: 18px; letter-spacing: 0.2em; }
  .logo-sub { font-size: 11px; margin-top: 2px; }

  /* Contact button: icon-only tall rounded rect */
  .sidebar-contact {
    flex-direction: column; width: auto; padding: 10px 14px;
    border-radius: 16px; gap: 0;
  }
  .sidebar-contact .material-icons {
    background: var(--blue2); border-radius: 50%; font-size: 20px; padding: 8px;
  }
  .contact-label { display: none; }

  /* Hamburger: plain bars, no box */
  .menu-btn {
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    gap: 7px; width: 36px; height: 36px; background: transparent;
    border: none; cursor: pointer; flex-shrink: 0; padding: 0;
  }
  .menu-btn:hover { background: transparent; }
  .menu-bar {
    display: block; width: 26px; height: 2px; background: var(--navy2);
    border-radius: 2px; transition: transform 0.3s, opacity 0.3s;
  }
  .menu-btn.open .menu-bar:nth-child(1) { transform: translateY(4.5px) rotate(45deg); }
  .menu-btn.open .menu-bar:nth-child(2) { transform: translateY(-4.5px) rotate(-45deg); }

  /* Modal */
  .modals {
    position: fixed; inset: 0; z-index: 200;
    pointer-events: none; opacity: 0; transition: opacity 0.25s;
  }
  .modals.open { display: block; pointer-events: auto; opacity: 1; }
  .design-canvas__modal { position: absolute; inset: 0; display: flex; }
  .design-canvas__modal__base { display: none; }
  .studio-canvas {
    position: relative; z-index: 1; width: 100%; height: 100%;
    background: var(--navy); display: flex; flex-direction: column;
    transform: translateX(100%); transition: transform 0.3s ease;
  }
  .modals.open .studio-canvas { transform: translateX(0); }

  .modal-inner { display: flex; flex-direction: column; height: 100%; padding: 20px 24px 32px; }
  .modal-header { display: flex; justify-content: flex-end; margin-bottom: 16px; }
  .modal-close {
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; background: transparent;
    border: none; cursor: pointer; padding: 0; position: relative;
  }
  .modal-close .menu-bar {
    position: absolute; width: 22px; height: 2px; background: var(--white); border-radius: 2px;
  }
  .modal-close .menu-bar:nth-child(1) { transform: rotate(45deg); }
  .modal-close .menu-bar:nth-child(2) { transform: rotate(-45deg); }

  .modal-nav { list-style: none; flex: 1; display: flex; flex-direction: column; justify-content: center; }
  .modal-nav li { border-bottom: 1px solid rgba(255,255,255,0.15); }
  .modal-nav li:first-child { border-top: 1px solid rgba(255,255,255,0.15); }
  .modal-nav a {
    display: block; font-family: var(--font-jp); font-size: 18px; font-weight: 500;
    color: var(--white); text-decoration: none; padding: 28px 0; text-align: center;
    transition: color 0.2s;
  }
  .modal-nav a:hover { color: var(--blue3); }
  .modal-nav a.active { color: var(--blue3); }

  .modal-contact {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 8px; background: var(--blue2); border-radius: 20px; padding: 20px;
    text-decoration: none; margin: 16px 16px 0; transition: background 0.2s;
  }
  .modal-contact:hover { background: #0163ac; }
  .modal-contact .material-icons { color: var(--white); font-size: 24px; }
  .modal-contact span:last-child { font-family: var(--font-jp); font-size: 16px; font-weight: 700; color: var(--white); }
}
</style>

<script>
const backToTop = document.getElementById('backToTop');
window.addEventListener('scroll', () => {
  backToTop?.classList.toggle('visible', window.scrollY > 300);
}, { passive: true });
backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

const els = document.querySelectorAll('.appear');
const io = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
  });
}, { threshold: 0.1 });
els.forEach(el => io.observe(el));

const menuBtn = document.getElementById('menuBtn');
const mobileNav = document.getElementById('mobileNav');
const modalClose = document.getElementById('modalClose');
const modalBackdrop = document.getElementById('modalBackdrop');

function openModal() {
  mobileNav?.classList.add('open');
  menuBtn?.classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeModal() {
  mobileNav?.classList.remove('open');
  menuBtn?.classList.remove('open');
  document.body.style.overflow = '';
}

menuBtn?.addEventListener('click', () => {
  mobileNav?.classList.contains('open') ? closeModal() : openModal();
});
modalClose?.addEventListener('click', closeModal);
modalBackdrop?.addEventListener('click', closeModal);
mobileNav?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeModal));
</script>

</body>
</html>
