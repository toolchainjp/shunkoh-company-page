---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SHUNKOH | Contact お問い合わせ" activePage="contact">

  <!-- Page Header -->
  <section class="page-header">
    <div class="header-title-row appear">
      <h1 class="page-title">Contact</h1>
      <p class="page-subtitle">お問い合わせ</p>
    </div>
    <div class="dot" style="width:14px;height:14px;background:#3397e2;top:79px;left:26px;"></div>
    <div class="dot" style="width:10px;height:10px;background:#0e3b7b;bottom:72px;left:39px;"></div>
    <div class="dot" style="width:8px;height:8px;background:#d3c8a5;top:101px;left:78px;"></div>
    <div class="dot" style="width:14px;height:14px;background:#d3c8a5;bottom:105px;right:281px;"></div>
    <div class="dot" style="width:10px;height:10px;background:#0f3b7c;bottom:82px;right:211px;"></div>
    <div class="dot" style="width:8px;height:8px;background:#0571c1;bottom:111px;right:180px;"></div>
  </section>

  <!-- Contact Form -->
  <section class="contact-main">
    <div class="contact-wrapper">

      <!-- Info Column -->
      <div class="contact-info appear">
        <div class="info-block">
          <p class="info-label">CONTACT</p>
          <p class="info-title">お問い合わせ</p>
          <p class="info-desc">無料相談のお申し込みやサービスに関するご質問など、お気軽にお問い合わせください。</p>
          <div class="info-badge">
            <span class="material-icons">schedule</span>
            <span class="info-badge-text">2営業日以内にご返信</span>
          </div>
        </div>
        <div class="info-block">
          <p class="info-label">OFFICE</p>
          <p class="info-title">東京オフィス</p>
          <p class="info-desc">〒158-0098<br>東京都世田谷区上用賀1-7-22-303</p>
        </div>
        <div class="info-block">
          <p class="info-label">HEAD OFFICE</p>
          <p class="info-title">本社</p>
          <p class="info-desc">〒344-0063<br>埼玉県春日部市緑町1-6-2</p>
        </div>
      </div>

      <div class="divider-v"></div>

      <!-- Form Column -->
      <div class="form-wrapper appear" style="transition-delay:.1s">
        <p class="form-intro">
          初回ご相談は無料となっております。<br />
          どんな小さなことでも、まずはお気軽にご相談ください。
        </p>

        <form id="contactForm" novalidate>
          <input type="hidden" name="access_key" value="cee2b25a-c678-4754-bea2-91a84b3aef6c" />
          <input type="hidden" name="subject" value="【SHUNKOH】サイトからのお問い合わせ" />
          <input type="hidden" name="from_name" value="SHUNKOH コーポレートサイト" />
          <!-- Honeypot: hidden from users, filled only by bots -->
          <input type="checkbox" name="botcheck" class="form-botcheck" tabindex="-1" autocomplete="off" />

          <div class="form-group">
            <label class="form-label" for="company">
              会社名 <span class="form-optional">任意</span>
            </label>
            <input class="form-input" type="text" id="company" name="company" placeholder="株式会社XXX" />
          </div>

          <div class="form-group">
            <label class="form-label" for="name">
              お名前 <span class="form-required">必須</span>
            </label>
            <input class="form-input" type="text" id="name" name="name" placeholder="田中 太郎" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="email">
              メールアドレス <span class="form-required">必須</span>
            </label>
            <input class="form-input" type="email" id="email" name="email" placeholder="info@example.com" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="phone">
              電話番号 <span class="form-optional">任意</span>
            </label>
            <input class="form-input" type="tel" id="phone" name="phone" placeholder="080-1234-XXXX" />
          </div>

          <div class="form-group">
            <label class="form-label">
              お問い合わせ項目 <span class="form-required">必須</span>
            </label>
            <div class="form-radio-group">
              <label class="form-radio">
                <input type="radio" name="category" value="初回相談のお申し込み" checked />
                <span>初回相談のお申し込み</span>
              </label>
              <label class="form-radio">
                <input type="radio" name="category" value="サービスに関するご質問" />
                <span>サービスに関するご質問</span>
              </label>
              <label class="form-radio">
                <input type="radio" name="category" value="協業のご提案" />
                <span>協業のご提案</span>
              </label>
              <label class="form-radio">
                <input type="radio" name="category" value="その他" />
                <span>その他</span>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="message">
              お問い合わせ内容 <span class="form-required">必須</span>
            </label>
            <textarea class="form-textarea" id="message" name="message" placeholder="お問い合わせ内容をご入力ください" required></textarea>
          </div>

          <p class="form-privacy">
            送信前に<a href="#">プライバシーポリシー</a>をご確認ください。<br />
            ご入力いただいた個人情報は、お問い合わせへの返答にのみ使用いたします。
          </p>

          <button class="form-submit" type="submit" id="formSubmit">
            <span class="material-icons">send</span>
            <span id="formSubmitLabel">送信する</span>
          </button>

          <p class="form-error" id="formError" role="alert"></p>
        </form>

        <div class="form-success" id="formSuccess">
          <span class="material-icons">check_circle</span>
          <p class="form-success-title">送信が完了しました</p>
          <p class="form-success-desc">お問い合わせありがとうございます。<br>2営業日以内にご返信いたします。<br>しばらくお待ちください。</p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
body { background: var(--navy); }
.main { background: var(--navy); }

.contact-main { width: 100%; background: var(--navy); padding: 80px 60px; display: flex; flex-direction: column; align-items: center; }
.contact-wrapper { width: 100%; max-width: 900px; display: flex; gap: 60px; align-items: flex-start; }
.contact-info { flex-shrink: 0; width: 260px; }
.info-block { margin-bottom: 40px; }
.info-label { font-family: var(--font-en); font-size: 12px; font-weight: 500; color: var(--sand); letter-spacing: 0.12em; margin-bottom: 10px; }
.info-title { font-family: var(--font-jp); font-size: 18px; font-weight: 500; color: var(--white); margin-bottom: 8px; }
.info-desc { font-family: var(--font-jp); font-size: 13px; color: rgba(255,255,255,0.7); line-height: 1.9; }
.info-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(53,151,226,0.15); border: 1px solid rgba(53,151,226,0.3); border-radius: 8px; padding: 10px 16px; margin-top: 16px; }
.info-badge .material-icons { font-size: 18px; color: var(--blue3); }
.info-badge-text { font-size: 13px; font-weight: 500; color: var(--blue3); }
.divider-v { width: 1px; background: rgba(255,255,255,0.1); align-self: stretch; flex-shrink: 0; }

.form-wrapper { flex: 1; }
.form-intro { font-family: var(--font-jp); font-size: 14px; color: rgba(255,255,255,0.7); line-height: 1.9; margin-bottom: 36px; }
.form-group { margin-bottom: 28px; }
.form-label { display: block; font-family: var(--font-jp); font-size: 14px; font-weight: 500; color: var(--white); margin-bottom: 10px; }
.form-required { display: inline-block; font-size: 11px; font-weight: 700; color: var(--blue3); background: rgba(53,151,226,0.15); border-radius: 4px; padding: 1px 6px; margin-left: 8px; vertical-align: middle; }
.form-optional { display: inline-block; font-size: 11px; color: rgba(255,255,255,0.4); margin-left: 8px; vertical-align: middle; }
.form-input, .form-select, .form-textarea {
  width: 100%; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15);
  border-radius: 12px; padding: 14px 18px; font-family: var(--font-jp); font-size: 15px;
  color: var(--white); transition: border-color 0.2s, background 0.2s; outline: none;
}
.form-input::placeholder, .form-textarea::placeholder { color: rgba(255,255,255,0.3); }
.form-input:focus, .form-select:focus, .form-textarea:focus {
  border-color: var(--blue3); background: rgba(255,255,255,0.1);
}
.form-textarea { resize: vertical; min-height: 160px; line-height: 1.7; }
.form-radio-group { display: flex; flex-direction: column; gap: 12px; }
.form-radio { display: flex; align-items: center; gap: 12px; cursor: pointer; }
.form-radio input[type="radio"] { appearance: none; width: 20px; height: 20px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.3); transition: all 0.2s; flex-shrink: 0; cursor: pointer; }
.form-radio input[type="radio"]:checked { border-color: var(--blue3); background: var(--blue3); box-shadow: inset 0 0 0 4px var(--navy); }
.form-radio span { font-size: 14px; color: rgba(255,255,255,0.85); }
.form-privacy { font-size: 13px; color: rgba(255,255,255,0.6); line-height: 1.8; margin-bottom: 32px; }
.form-privacy a { color: var(--blue3); text-decoration: underline; }
.form-submit { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; background: var(--blue2); border: none; border-radius: 16px; padding: 20px 40px; font-family: var(--font-jp); font-size: 17px; font-weight: 700; color: var(--white); cursor: pointer; transition: background 0.2s, scale 0.2s; }
.form-submit:hover { background: #0456a0; scale: 0.98; }
.form-submit .material-icons { font-size: 20px; }
.form-submit:disabled { background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.5); cursor: not-allowed; scale: 1; }

.form-botcheck { position: absolute; left: -9999px; opacity: 0; pointer-events: none; }
.form-error {
  display: none; margin-top: 20px; padding: 14px 18px; border-radius: 12px;
  background: rgba(226,76,76,0.12); border: 1px solid rgba(226,76,76,0.35);
  font-family: var(--font-jp); font-size: 14px; color: #ffb4b4; line-height: 1.8;
}

.form-success { display: none; text-align: center; padding: 60px 40px; }
.form-success .material-icons { font-size: 64px; color: var(--blue3); margin-bottom: 20px; }
.form-success-title { font-size: 24px; font-weight: 500; color: var(--white); margin-bottom: 12px; }
.form-success-desc { font-size: 14px; color: rgba(255,255,255,0.7); line-height: 1.9; }

@media (max-width: 960px) {
  .contact-wrapper { flex-direction: column; gap: 40px; }
  .contact-info { width: 100%; }
  .divider-v { display: none; }
}
@media (max-width: 540px) {
  .contact-main { padding: 60px 24px; }
}
</style>

<script>
const form = document.getElementById('contactForm') as HTMLFormElement | null;
const successPanel = document.getElementById('formSuccess');
const errorPanel = document.getElementById('formError');
const submitBtn = document.getElementById('formSubmit') as HTMLButtonElement | null;
const submitLabel = document.getElementById('formSubmitLabel');

form?.addEventListener('submit', async (e) => {
  e.preventDefault();

  // novalidate is set so the browser stays quiet until submit; check by hand.
  if (!form.checkValidity()) {
    form.reportValidity();
    return;
  }

  if (errorPanel) errorPanel.style.display = 'none';
  if (submitBtn) submitBtn.disabled = true;
  if (submitLabel) submitLabel.textContent = '送信中...';

  try {
    const res = await fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { Accept: 'application/json' },
      body: new FormData(form),
    });
    const data = await res.json().catch(() => null);

    if (res.ok && data?.success) {
      form.style.display = 'none';
      if (successPanel) {
        successPanel.style.display = 'block';
        successPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      return;
    }
    throw new Error(data?.message ?? `HTTP ${res.status}`);
  } catch (err) {
    console.error('Web3Forms submit failed:', err);
    if (errorPanel) {
      errorPanel.textContent =
        '送信に失敗しました。時間をおいて再度お試しください。繰り返し失敗する場合は、お手数ですがお電話にてご連絡ください。';
      errorPanel.style.display = 'block';
    }
  } finally {
    if (submitBtn) submitBtn.disabled = false;
    if (submitLabel) submitLabel.textContent = '送信する';
  }
});
</script>
